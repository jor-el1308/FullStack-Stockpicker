# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=stockpicker
DB_PASSWORD=changeme
DB_NAME=stockpicker
# Shared team database (optional) - point DB_HOST/DB_USER/DB_PASSWORD above
# at an external MySQL instead of a local install, e.g. Aiven's always-free
# tier (https://aiven.io/free-mysql-database). Most external hosts require
# TLS - set DB_SSL=true, and optionally DB_SSL_CA to a downloaded CA cert
# path for proper verification (without it, DB_SSL=true still encrypts the
# connection but doesn't verify the server certificate). See README's
# "Shared team database" section.
DB_SSL=false
DB_SSL_CA=

# Auth (Person 1)
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# Subscription/Paywall (Person 2) - Stripe TEST MODE checkout, monthly
# recurring subscription (mode: "subscription" - see subscription.service.js).
# 1. Sign up free at https://dashboard.stripe.com/register (no business
#    verification needed to use test mode).
# 2. Make sure the "Test mode" toggle in the dashboard is ON.
# 3. Go to Developers -> API keys and copy the "Secret key" (starts sk_test_).
# 4. Paste it below. Never commit a real (sk_live_) key - test keys only
#    move fake money, live keys move real money.
STRIPE_SECRET_KEY=

# Stripe webhook (reliable path for activation, renewals, failed renewals,
# and cancellations - see subscription.service.js's handleCheckoutSessionCompleted()/
# handleSubscriptionUpdated()/handleSubscriptionDeleted()/handleInvoicePaid()).
# Without this, activation only happens if the user's browser makes it back
# to /activate after paying, and nothing keeps `is_active` in sync once a
# subscription renews, fails to renew, or is canceled from the billing portal.
# 1. Local dev: install the Stripe CLI (https://stripe.com/docs/stripe-cli),
#    run `stripe listen --forward-to localhost:4000/api/subscription/webhook`,
#    and paste the "whsec_..." it prints below.
# 2. Deployed: Dashboard -> Developers -> Webhooks -> Add endpoint, pointing
#    at https://<your-domain>/api/subscription/webhook, subscribed to these
#    events: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted, invoice.paid. Copy its signing secret below.
STRIPE_WEBHOOK_SECRET=

# Subscription/Paywall (Person 2) - welcome email sent once activation
# payment succeeds (server/src/utils/mailer.js). Works with any SMTP
# provider. Easiest for local testing: sign up free at
# https://ethereal.email (fake inbox, nothing actually gets delivered,
# just lets you see the rendered email) and paste its generated
# host/user/password below. For a real provider, Gmail needs an "app
# password" (not your normal password) with SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587. If these are left blank, sending is skipped (logged, not
# an error) so it never blocks the paywall/activation flow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Stock Screener <no-reply@example.com>"

# Notifications (Person 5)
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_TOKEN=

# AI recommendation step (Person 1, section 6 of requirement doc) - sends
# shortlisted stocks to an LLM for qualitative analysis after a screen runs
# (server/src/services/ai.service.js). Settings -> AI preferences lets a
# user pick which model tier to use: Gemini 2.5 Flash [default] calls Google
# directly with this key. Get a free key (no credit card) at
# https://aistudio.google.com/app/apikey - click "Create API key".
AI_RECOMMENDATION_API_KEY=

# The other three tiers (GPT-4o mini, Claude Haiku 4.5, DeepSeek Chat) route
# through OpenRouter (https://openrouter.ai) under this one key, so there's
# only one key to manage no matter which of those a user picks. Requires
# OpenRouter account credits to actually run - safe to leave blank while
# developing against Gemini Flash only.
# 1. Sign up free at https://openrouter.ai.
# 2. Go to https://openrouter.ai/keys and click "Create Key".
# 3. Paste it below. See MODEL_TIERS in server/src/services/ai.service.js
#    for the exact OpenRouter model slug used by each tier.
OPENROUTER_API_KEY=

# "Sign in with Google" (Person 1) - standard OAuth 2.0 authorization code
# flow (server/src/services/googleOAuth.service.js /
# server/src/controllers/auth.controller.js's googleOAuthStart()/
# googleOAuthCallback()). The client's Google button on the login page just
# links to GET /api/auth/oauth/google - no Google JS SDK involved.
# 1. Go to https://console.cloud.google.com/apis/credentials (create a
#    project first if you don't have one).
# 2. Configure the OAuth consent screen if prompted (External, add your own
#    email as a test user while the app is unpublished).
# 3. Create Credentials -> OAuth client ID -> Application type "Web
#    application".
# 4. Under "Authorized redirect URIs" add the exact value of
#    GOOGLE_REDIRECT_URI below (must match exactly, including the path).
# 5. Copy the generated "Client ID" and "Client secret" below. Never commit
#    real values - this file only ever holds blank placeholders.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" configured in step 4
# above. Change the host when deploying (e.g.
# https://api.yourdomain.com/api/auth/oauth/google/callback).
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/oauth/google/callback

# "Sign in with Microsoft" (Person 1) - standard OAuth 2.0 authorization code
# flow against the Microsoft identity platform (server/src/services/
# microsoftOAuth.service.js / server/src/controllers/auth.controller.js's
# microsoftOAuthStart()/microsoftOAuthCallback()). The client's Microsoft
# button on the login page just links to GET /api/auth/oauth/microsoft - no
# MSAL JS SDK involved.
# 1. Go to https://portal.azure.com -> Microsoft Entra ID -> App registrations
#    -> New registration.
# 2. Under "Supported account types" pick who may sign in (any Microsoft
#    account, or only your organization's).
# 3. Under "Redirect URI" add a "Web" platform with the exact value of
#    MS_REDIRECT_URI below (must match exactly, including the path).
# 4. After creating it, copy the "Application (client) ID" below, and under
#    Certificates & secrets -> New client secret, copy the generated value
#    (not the secret ID) below. Never commit real values - this file only
#    ever holds blank placeholders.
# 5. Under API permissions, "User.Read" (Microsoft Graph, delegated) is
#    added by default - that's all this flow needs.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" accepts both personal Microsoft accounts and any work/school
# tenant. Use a specific tenant id (from the app registration's Overview
# page) to restrict sign-in to one organization.
MS_TENANT_ID=common
# Must exactly match a redirect URI configured in step 3 above. Change the
# host when deploying (e.g.
# https://api.yourdomain.com/api/auth/oauth/microsoft/callback).
MS_REDIRECT_URI=http://localhost:4000/api/auth/oauth/microsoft/callback

# Where to send the browser after an OAuth round trip finishes (success or
# failure) - the client's origin, since the callback runs on the API.
# googleOAuthCallback() appends its own /login?oauth=... query string onto
# this. Change the host when deploying (the client's real URL).
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/
