# =============================================================================
# PRODUCTION env for the Render Web Service (backend).
# These are the EXACT variable names the server reads (server/src/config/*,
# server/src/app.js). Set them in Render's dashboard -> your service ->
# Environment. Do NOT commit a filled-in copy of this file.
#
# NOTE: this app uses MySQL (mysql2 driver), NOT Postgres. There is no
# DATABASE_URL. The connection is built from the discrete DB_* vars below
# (server/src/config/dbEnv.js).
# =============================================================================

# --- Core ---
NODE_ENV=production
# Render provides its own PORT; the server already reads process.env.PORT.
# Leave PORT unset on Render (it injects it). Locally it defaults to 4000.

# --- Database: Aiven MySQL (free tier) ---
# From the Aiven service Overview -> Connection information.
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
# Aiven requires TLS.
DB_SSL=true
# Optional but recommended: verify Aiven's server cert. The repo ships the CA
# at server/aiven-ca.pem, which is included in the Render deploy (root dir =
# server). Path is relative to the server working directory.
DB_SSL_CA=aiven-ca.pem

# --- Auth ---
# Generate a long random string, e.g. `openssl rand -hex 32`. Keep it secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Frontend origin ---
# The var is CLIENT_ORIGIN (NOT FRONTEND_URL). Set to your Vercel URL.
# Used for CORS, Stripe redirect URLs, and email links.
CLIENT_ORIGIN=https://your-frontend.vercel.app

# --- Seeding ---
# Set to false in production so the server does NOT re-seed sample data on
# every restart. (The Docker dev setup defaults this to true.)
AUTO_SEED=false

# --- Optional integrations (app runs without these) ---
# Stripe TEST-mode key so the paywall/checkout works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# SMTP so welcome emails + login 2FA codes are emailed instead of logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Stock Screener <no-reply@example.com>"
